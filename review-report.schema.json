{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://techhandbook.nullyard.com/schemas/review-report.schema.json",
  "title": "TechHandbook review report",
  "description": "Persisted report created by a trusted reviewer for a specific fragment of an article.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "article_id",
    "language",
    "route",
    "section_id",
    "target_type",
    "block_index",
    "text_snapshot",
    "reason",
    "reporter_stamp",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^rpt-[A-Za-z0-9_-]+$"
    },
    "article_id": {
      "type": "string",
      "pattern": "^doc-[0-9]+$",
      "description": "Stable article ID shared by language versions."
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "route": {
      "type": "string",
      "pattern": "^/",
      "description": "Article route at the time the report was created."
    },
    "section_id": {
      "type": "string",
      "minLength": 1,
      "description": "Anchor of the nearest containing heading generated by the existing heading/TOC algorithm."
    },
    "target_type": {
      "type": "string",
      "enum": [
        "heading",
        "paragraph",
        "list-item",
        "code-block",
        "table"
      ]
    },
    "block_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based occurrence of the target block type inside the section at report time. It is a locator hint, not a permanent content identity."
    },
    "text_snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Plain-text snapshot of the reported fragment, used to relocate it after later article edits."
    },
    "reason": {
      "type": "string",
      "enum": [
        "outdated",
        "incorrect",
        "unclear",
        "incomplete",
        "broken",
        "typo-format"
      ]
    },
    "reporter_stamp": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Server-generated SHA-256 pseudonymous stamp. Raw IP is not stored."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "dismissed"
      ]
    },
    "resolved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "analysis_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "done",
        "error"
      ]
    },
    "analysis_result": {
      "type": [
        "string",
        "null"
      ],
      "description": "JSON-encoded advisory analysis generated by Luma."
    },
    "analysis_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "analyzed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "analysis_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "suggestion_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "manual",
        "rejected"
      ]
    },
    "suggestion_decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
